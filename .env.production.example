# Production settings for Tahselly — copy to .env on the server and fill the empty values.
# Never commit the real .env.

APP_NAME=Tahselly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.ae
APP_TIMEZONE=Asia/Dubai
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Email delivery (e.g. Resend / Postmark / your host's SMTP) — use an address on your own domain
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.ae"
MAIL_FROM_NAME="${APP_NAME}"

# Payments: live key from Stripe → Developers → API keys; webhook secret from the endpoint you add
# at https://your-domain.ae/stripe/webhook (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SANDBOX=false

VITE_APP_NAME="${APP_NAME}"
